@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Dynamic Book Tracker</PageTitle>

<div class="home-shell">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">Realtime demo experience</p>
            <h1>Bring a cosy bookshop to life with live updates.</h1>

            <div class="hero-actions">
                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-primary btn-lg" href="/books">Open the live library</a>
                        <a class="btn btn-outline-secondary btn-lg" href="/.auth/logout">Sign out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary btn-lg" href="/.auth/login/aad">Log in to start the demo</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </section>
</div>
