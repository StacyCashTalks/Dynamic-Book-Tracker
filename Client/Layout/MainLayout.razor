@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Client.Services
@inject NotificationService NotificationService
@implements IDisposable

@if (notifications.Any())
{
    <div class="notification-toast-container">
        @foreach (var notification in notifications)
        {
            <div class="app-toast card-surface" role="alert">
                <div class="app-toast-header">
                    <div>
                        <span class="app-toast-label">Live update</span>
                        <strong>@notification.Type</strong>
                    </div>
                    <button type="button" class="btn-close" @onclick="@(() => RemoveNotification(notification))" aria-label="Dismiss notification"></button>
                </div>
                <div class="app-toast-body">
                    @notification.Message
                </div>
            </div>
        }
    </div>
}

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row-title">
                <span class="top-row-kicker">Demo mode</span>
                <strong>Dynamic Book Tracker</strong>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="top-row-actions">
                        <span class="welcome-pill">Welcome, @context.User.Identity?.Name</span>
                        <a class="btn btn-outline-secondary" href="/books">Open library</a>
                        <a class="btn btn-outline-secondary" href="/.auth/logout">Log out</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="top-row-actions">
                        <a class="btn btn-primary" href="/.auth/login/aad">Log in</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private readonly List<Notification> notifications = [];

    protected override void OnInitialized()
    {
        NotificationService.OnNotificationReceived += HandleNotification;
    }

    private void HandleNotification(Notification notification)
    {
        notifications.Insert(0, notification);

        if (notifications.Count > 4)
        {
            notifications.RemoveAt(notifications.Count - 1);
        }

        _ = DismissLaterAsync(notification);
        InvokeAsync(StateHasChanged);
    }

    private async Task DismissLaterAsync(Notification notification)
    {
        await Task.Delay(5000);
        await InvokeAsync(() => RemoveNotification(notification));
    }

    private void RemoveNotification(Notification notification)
    {
        if (notifications.Remove(notification))
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= HandleNotification;
    }
}
